/* nvm_map.def
*
* NVM_FIELD(name, DPL_LIST, DPL_VALUE, CNTRL_VALUE)
*
* DPL_VALUE: datapool global variable
* CNTRL_VALUE: control structure varialbe
*/

/* Elevator Control Parameters */
NVM_FIELD(elevatorMinSpeed, CONFIGURATION_LIST_INDEX_ELEVATORCONFIG, gt_Configuration_DataPoolValues.t_ElevatorConfigValues.u8_minSpeed, gt_elevatorConfig.u8_minSpeed)
NVM_FIELD(elevatorMaxSpeed, CONFIGURATION_LIST_INDEX_ELEVATORCONFIG, gt_Configuration_DataPoolValues.t_ElevatorConfigValues.u8_maxSpeed, gt_elevatorConfig.u8_maxSpeed)

/* Header Control Parameter */
NVM_FIELD(hllEnable, CONFIGURATION_LIST_INDEX_HEADERCONFIG, gt_Configuration_DataPoolValues.t_HeaderConfigValues.u8_joystick_hll_enable, gt_headerConfig.u8_joystick_hll_enable)

/* Stickbox Control Parameter */
NVM_FIELD(stickBoxInstalled, CONFIGURATION_LIST_INDEX_STICKBOXCONFIG, gt_Configuration_DataPoolValues.t_StickBoxConfigValues.u8_stick_box_installed, gt_stickBConfig.u8_stick_box_installed)

/* MISC Control Parameter */
NVM_FIELD(fuelHighDdb, CONFIGURATION_LIST_INDEX_MISCCONFIG, gt_Configuration_DataPoolValues.t_MiscConfigValues.u16_fuel_high_deadband, gt_miscConfig.u16_fuel_high_deadband)
NVM_FIELD(filterRSTNMax, CONFIGURATION_LIST_INDEX_MISCCONFIG, gt_Configuration_DataPoolValues.t_MiscConfigValues.u16_filter_rstn_max, gt_miscConfig.u16_filter_rstn_max)