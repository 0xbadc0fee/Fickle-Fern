/* can_out_map.def
*
* CNTRL2DP(name, DPL_VALUE, CNTRL_VALUE)
*
* DP_LVALUE: expression that can be assigned into (datapool global field)
* SRC_RVALUE: expression that yields the value to assign (from control structs)
*/

/* Elevator Control Outputs */
CNTRL2DP(elevatorStatus,   		 gt_can_devs.t_display.u8_elevatorStatus, 	  			gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Display_Trans1_AgvWorkElevatorOn)

/* Header Control Outputs */
CNTRL2DP(reliefStatus, 	   	     gt_can_devs.t_display.u8_relief_switch_status, 		gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Display_Trans1_AgvChassisHydOilPressRelief)

/* Auger Cart Control Outputs */
CNTRL2DP(augerStatus, 	   		 gt_can_devs.t_display.u8_auger_status,   	  			gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Display_Trans1_AgvWorkAugerUnloadOn)
CNTRL2DP(button2LED, 	   		 gt_can_devs.t_buttonPanel.u8_b2_lights, 	 	  		gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Btn_Panel_Trans_Button_Ind_02_Auger)
CNTRL2DP(button6LED, 	   		 gt_can_devs.t_buttonPanel.u8_b6_lights, 	  	  		gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Btn_Panel_Trans_Button_Ind_06_ManUL)

/* Light Control Outputs */
CNTRL2DP(lightStatus,      		 gt_can_devs.t_buttonPanel.u8_b4_lights,	  	  		gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Btn_Panel_Trans_Button_Ind_04_Lights)
CNTRL2DP(headLightStatus,  		 gt_can_devs.t_display.u8_headlights_status,    		gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Display_Trans1_AgvChassisHeadLtsOn)
CNTRL2DP(workLightStatus,  		 gt_can_devs.t_display.u8_worklights_status,    		gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Display_Trans1_AgvChassisWorkLtsOn)

/* Cleaning Chains Outputs */
CNTRL2DP(shaftDriveStatus, 		 gt_can_devs.t_display.u8_shaft_drive_status,   	 	 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Display_Trans1_AgvWorkShaftDrvsOn)

/*Stick Box Outputs*/
CNTRL2DP(button3LED, 	   		 gt_can_devs.t_buttonPanel.u8_b3_lights, 	 	  		 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Btn_Panel_Trans_Button_Ind_03_SB_OP)
CNTRL2DP(button7LED, 	   		 gt_can_devs.t_buttonPanel.u8_b7_lights, 	  	  		 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Btn_Panel_Trans_Button_Ind_07_SB_CL)

/*Suction Fan Outputs*/
CNTRL2DP(suctionFanEnable,   	 gt_can_devs.t_display.u8_suction_fan_enable_status,  	 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Display_Trans1_AgvWorkSuctionFanOn)
CNTRL2DP(suctionFanSpeedRPM,  	 gt_can_devs.t_display.u16_suction_fan_speed_status_rpm, gt_J1939_DataPoolValues.t_CAN1_TXValues.u16_CAN_Display_Trans2_AgvWorkSuctionFanRpm)

/* Stick Remover CAN Parameters */
CNTRL2DP(stickRemStatus,   		 gt_can_devs.t_display.u8_stick_remover_status, 		 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Display_Trans1_AgvWorkStickRemoverOn)
CNTRL2DP(button8LED, 	   		 gt_can_devs.t_buttonPanel.u8_b8_lights,		  		 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Btn_Panel_Trans_Button_Ind_08_SR)

/* Propulsion */
CNTRL2DP(wheelSpeed,   	   		 gt_can_devs.t_display.u8_wheel_speed_10, 	  			 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Display_Trans1_AgvChassisGroundSpeed10x)
CNTRL2DP(slSet, 	       		 gt_can_devs.t_display.u8_speed_limit_set,	  			 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Display_Trans1_AgvChassisSpeedLimiterSet)
CNTRL2DP(neutralState, 	   		 gt_can_devs.t_display.u8_neutral_state,		  		 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Display_Trans1_AgvChassisNeutralState)

/* Power Assist */
CNTRL2DP(paEnable,   	   		 gt_can_devs.t_buttonPanel.u8_b5_lights, 	      		 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Btn_Panel_Trans_Button_Ind_05_PA)

/* Engine Starter Outputs*/
CNTRL2DP(neutralState, 	   		 gt_can_devs.t_display.u8_neutral_safe_status, 	  		 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_CAN_Display_Trans1_AgvChassisSafeNeutralState)

/* Throttle Control Outputs */
CNTRL2DP(engineOverrideCtrlMode, gt_can_devs.t_engine.u8_eng_ovrrd_ctrl_mode, 	  		 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_TSC1_EngOverrideCtrlMode)
CNTRL2DP(engineReqSpeedCtrlCond, gt_can_devs.t_engine.u8_engine_speed_ctrl_req, 		 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_TSC1_EngRqedSpeedCtrlConditions)
CNTRL2DP(engineReqSpeedCtrlCond, gt_can_devs.t_engine.u8_engine_override_ctrl_pri, 		 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_TSC1_OverrideCtrlModePriority)
CNTRL2DP(engineSpeedLimit, 	   	 gt_can_devs.t_engine.u16_engine_req_speed, 	  		 gt_J1939_DataPoolValues.t_CAN1_TXValues.u16_TSC1_EngRqedSpeed_SpeedLimit)
CNTRL2DP(engineTorqLimit, 	     gt_can_devs.t_engine.u8_eng_req_torq_limit, 	  		 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_TSC1_EngRqedTorque_TorqueLimit)
CNTRL2DP(engineControlPurp, 	 gt_can_devs.t_engine.u8_ctrl_purpose, 	  				 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_TSC1_ControlPurpose)
CNTRL2DP(engineTorqHiRes, 	     gt_can_devs.t_engine.u8_eng_req_torq_hires, 	  		 gt_J1939_DataPoolValues.t_CAN1_TXValues.u8_TSC1_EngineRequestedTorqueHiRes)

