/* checkpoints_map.def
*
* CNTRL2DP(name, DP_LVALUE, SRC_RVALUE)
*
* DP_LVALUE: expression that can be assigned into (datapool global field)
* SRC_RVALUE: expression that yields the value to assign (from your control structs)
*/

/* Header Control checkpoints */
CNTRL2DP(eleConfig2, 	 gt_headerConfig.u8_joystick_hll_enable,				gt_Dashboard_DataPoolValues.t_HeaderControlValues.u8_p_js_hll)	

/* Elevator Control checkpoints */
CNTRL2DP(elevatorCP1, 	 gt_elevatorCheckpoints.u8_status,  					gt_Dashboard_DataPoolValues.t_ElevatorControlValues.u8_status)
CNTRL2DP(elevatorCP2, 	 gt_elevatorCheckpoints.f32_speed_cmd, 					gt_Dashboard_DataPoolValues.t_ElevatorControlValues.f32_speed_cmd)
CNTRL2DP(elevatorCP3, 	 gt_elevatorCheckpoints.f32_output, 					gt_Dashboard_DataPoolValues.t_ElevatorControlValues.f32_output)
CNTRL2DP(eleConfig1, 	 gt_elevatorConfig.u8_vl3512_enable,				    gt_Dashboard_DataPoolValues.t_ElevatorControlValues.u8_p_vl3512_enable)	
CNTRL2DP(eleConfig2, 	 gt_elevatorConfig.u8_vl3514_enable,				    gt_Dashboard_DataPoolValues.t_ElevatorControlValues.u8_p_vl3514_enable)	


/* Cleaning Chains Control checkpoints */
CNTRL2DP(cchainsCP2,  	 gt_cleaningShaftCheckpoints.u8_status, 		    	gt_Dashboard_DataPoolValues.t_CleaningChainsControlsValues.u8_status)

/* Front Sweeps Control checkpoints */
CNTRL2DP(fsweepsCP2,  	 gt_frontSweepsCheckpoints.u8_speed_cmd, 	 			gt_Dashboard_DataPoolValues.t_FrontSweepsControlValues.u8_speed_cmd)

/* Rotary Trap Control checkpoints */
CNTRL2DP(rtrapCP2, 		 gt_rotaryTrapCheckpoints.f32_trap_target_cmd, 	 		gt_Dashboard_DataPoolValues.t_RotaryTrapValues.f32_trap_target_cmd)

/* Propulsion Control checkpoints */
CNTRL2DP(wheelRPM, 	 	 gt_propCheckpoints.f32_wheel_rpm, 						gt_Dashboard_DataPoolValues.t_PropulsionControlValues.f32_wheel_rpm)
CNTRL2DP(wheelSpeed, 	 gt_propCheckpoints.f32_wheel_speed_10, 				gt_Dashboard_DataPoolValues.t_PropulsionControlValues.f32_wheel_speed_mph_x10)
CNTRL2DP(edcEnable,  	 gt_propCheckpoints.u8_edc_enable, 						gt_Dashboard_DataPoolValues.t_PropulsionControlValues.u8_edc_enable)

/* Suction Fan Control checkpoints */
CNTRL2DP(sFanCP, 		 gt_suctionFanCheckpoints.u8_suctionFanOn, 	 			gt_Dashboard_DataPoolValues.t_SuctionFanControlValues.u8_suction_fan_on)
CNTRL2DP(sFanPWMCP, 	 gt_suctionFanCheckpoints.u16_pwmStatus, 	 			gt_Dashboard_DataPoolValues.t_SuctionFanControlValues.u16_pwm_status)
CNTRL2DP(sfconfig1, 	 gt_suctionFanConfig.u8_fan_inc_time,				    gt_Dashboard_DataPoolValues.t_SuctionFanControlValues.u8_p_sf_inctime)	
CNTRL2DP(sfconfig2, 	 gt_suctionFanConfig.u8_fan_dec_time,				    gt_Dashboard_DataPoolValues.t_SuctionFanControlValues.u8_p_sf_dectime)	
CNTRL2DP(sfconfig3, 	 gt_suctionFanConfig.f32_drive_ratio,				    gt_Dashboard_DataPoolValues.t_SuctionFanControlValues.u8_p_sf_dectime)

/* Engine Starter Control checkpoints */
CNTRL2DP(engOffCP, 		 gt_engineStarterCheckpoints.u8_eng_status, 	 		gt_Dashboard_DataPoolValues.t_EngineControlValues.u8_eng_status)
CNTRL2DP(startKeyCP, 	 gt_engineStarterCheckpoints.u8_start_key, 	 			gt_Dashboard_DataPoolValues.t_EngineControlValues.u8_start_key)
CNTRL2DP(suctionFanCP, 	 gt_engineStarterCheckpoints.u8_suction_fan_status, 	gt_Dashboard_DataPoolValues.t_EngineControlValues.u8_start_suction_fan_off)
CNTRL2DP(shaftDriveCP,   gt_engineStarterCheckpoints.u8_shaft_drive_status, 	gt_Dashboard_DataPoolValues.t_EngineControlValues.u8_start_shaft_drive_off)
CNTRL2DP(startNeutralCP, gt_engineStarterCheckpoints.u8_js_neutral, 	 	   	gt_Dashboard_DataPoolValues.t_EngineControlValues.u8_start_neutral)

/* Throttle Control checkpoints */
CNTRL2DP(throttleRMPCP,  gt_throttleCheckpoints.u16_eng_spd, 	 	 		    gt_Dashboard_DataPoolValues.t_EngineControlValues.u16_eng_spd)
CNTRL2DP(throttleUpCP,   gt_throttleCheckpoints.u8_eng_spd_up_osc,   		    gt_Dashboard_DataPoolValues.t_EngineControlValues.u8_eng_spd_up_osc)
CNTRL2DP(throttleDownCP, gt_throttleCheckpoints.u8_eng_spd_down_osc, 		    gt_Dashboard_DataPoolValues.t_EngineControlValues.u8_eng_spd_down_osc)

/* StickBox Control Dashboard */
CNTRL2DP(stickBoxConfig, gt_stickBConfig.u8_stick_box_installed,			    gt_Dashboard_DataPoolValues.t_StickBoxControlValues.u8_p_stick_box_installed)	 	 	    

/* Power Assist Control Dashboard */
CNTRL2DP(stickBoxConfig, gt_paConfig.u8_power_assist_installed,				    gt_Dashboard_DataPoolValues.t_PowerAssistControlValues.u8_p_pa_enable)	

/* Cooling Fan Control Parameters */
CNTRL2DP(coolLeadNum, 	gt_coolingFanCheckpoints.u8_leadsensornumber, 	 		gt_Dashboard_DataPoolValues.t_CoolingFanControlValues.u8_lead_sensor_id)
CNTRL2DP(rtrapCP2, 		gt_coolingFanCheckpoints.f32_cooling_demand_pct, 	 	gt_Dashboard_DataPoolValues.t_CoolingFanControlValues.f32_cooling_demand_pct)

/* MISC Control Parameters */
CNTRL2DP(fuelLevGagP, 	gt_miscCheckpoints.f32_fuel_level_gauge_pct, 			gt_Dashboard_DataPoolValues.t_MiscControlValues.f32_fuel_level_gauge_pct)
CNTRL2DP(filterRestP, 	gt_miscCheckpoints.f32_filter_rest_pct, 	   			gt_Dashboard_DataPoolValues.t_MiscControlValues.f32_filter_rest_pct)
CNTRL2DP(filterStatus,  gt_miscCheckpoints.u8_service_filter_status,   			gt_Dashboard_DataPoolValues.t_MiscControlValues.u8_service_filter_status)
CNTRL2DP(doorOpenStat,  gt_miscCheckpoints.u8_door_open_status, 	   			gt_Dashboard_DataPoolValues.t_MiscControlValues.u8_door_open_status)
CNTRL2DP(HydoilLow,     gt_miscCheckpoints.u8_low_hyd_fluid_indicator, 	 		gt_Dashboard_DataPoolValues.t_MiscControlValues.u8_low_hyd_fluid_indicator)
CNTRL2DP(brakesEngaged, gt_miscCheckpoints.u8_brakes_engaged, 	 				gt_Dashboard_DataPoolValues.t_MiscControlValues.u8_brakes_engaged)
CNTRL2DP(swMajor, 	    gt_miscCheckpoints.u8_sw_major_revision, 	 			gt_Dashboard_DataPoolValues.t_MiscControlValues.u8_sw_major_revision)
CNTRL2DP(swMinor, 		gt_miscCheckpoints.u8_sw_minor_revision, 	 			gt_Dashboard_DataPoolValues.t_MiscControlValues.u8_sw_minor_revision)
CNTRL2DP(filterMax, 	gt_miscConfig.u8_filter_rstn_max, 	 					gt_Dashboard_DataPoolValues.t_MiscControlValues.u8_p_filter_fault_pct)
CNTRL2DP(fuelHigh, 		gt_miscConfig.u16_fuel_high_deadband, 	 				gt_Dashboard_DataPoolValues.t_MiscControlValues.u16_p_fuel_full_voltage)



