/* checkpoints_map.def
*
* CNTRL2DP(name, DP_LVALUE, SRC_RVALUE)
*
* DP_LVALUE: expression that can be assigned into (datapool global field)
* SRC_RVALUE: expression that yields the value to assign (from your control structs)
*/

/* Elevator Control checkpoints */
CNTRL2DP(elevatorCP1, gt_elevatorCheckpoints.u8_chkPoint1,  	 gt_Checkpoints_DataPoolValues.t_ElevatorControlValues.u8_checkpoint1)
CNTRL2DP(elevatorCP2, gt_elevatorCheckpoints.s16_chkPoint2, 	 gt_Checkpoints_DataPoolValues.t_ElevatorControlValues.s16_checkpoint2)
CNTRL2DP(elevatorCP3, gt_elevatorCheckpoints.f32_chkPoint3, 	 gt_Checkpoints_DataPoolValues.t_ElevatorControlValues.f32_checkpoint3)

/* Cleaning Chains Control checkpoints */
CNTRL2DP(cchainsCP2, gt_cleaningShaftCheckpoints.u8_checkpoint1, gt_Checkpoints_DataPoolValues.t_CleaningChainsControlsValues.u8_checkpoint1)

/* Front Sweeps Control checkpoints */
CNTRL2DP(fsweepsCP2, gt_frontSweepsCheckpoints.u8_checkpoint1, 	 gt_Checkpoints_DataPoolValues.t_FrontSweepsControlValues.u8_checkpoint1)

/* Rotary Trap Control checkpoints */
CNTRL2DP(rtrapCP2, gt_rotaryTrapCheckpoints.u8_checkpoint1, 	 gt_Checkpoints_DataPoolValues.t_RotaryTrapValues.u8_checkpoint1)


/* Cooling Fan Control Parameters */
CNTRL2DP(coolLeadNum, gt_coolingFanCheckpoints.u8_leadsensornumber, 	 gt_Checkpoints_DataPoolValues.t_CoolingFanControlsValues.u8_leadsensornumber)
CNTRL2DP(coolDmdP, gt_coolingFanCheckpoints.f32_cooling_demand_pct, 	 gt_Checkpoints_DataPoolValues.t_CoolingFanControlsValues.f32_cooling_demand_pct)

/* MISC Control Parameters */
CNTRL2DP(fuelLevSen, gt_miscCheckpoints.f32_chk_fuel_level_sensor, 	 gt_Checkpoints_DataPoolValues.t_MiscControlsValues.f32_chk_fuel_level_sensor)
CNTRL2DP(fuelLevGagP, gt_miscCheckpoints.f32_chk_fuel_level_gauge_pct, 	 gt_Checkpoints_DataPoolValues.t_MiscControlsValues.f32_chk_fuel_level_gauge_pct)
CNTRL2DP(filterRestP, gt_miscCheckpoints.f32_chk_filter_rest_pct, 	 gt_Checkpoints_DataPoolValues.t_MiscControlsValues.f32_chk_filter_rest_pct)
CNTRL2DP(minderGagP, gt_miscCheckpoints.f32_chk_minder_gauge_pct, 	 gt_Checkpoints_DataPoolValues.t_MiscControlsValues.f32_chk_minder_gauge_pct)
CNTRL2DP(serviceFilterStat, gt_miscCheckpoints.u8_chk_service_filter_status, 	 gt_Checkpoints_DataPoolValues.t_MiscControlsValues.u8_chk_service_filter_status)
CNTRL2DP(doorOpenStat, gt_miscCheckpoints.u8_chk_door_open_status, 	 gt_Checkpoints_DataPoolValues.t_MiscControlsValues.u8_chk_door_open_status)
CNTRL2DP(lowHydFluidInd, gt_miscCheckpoints.u8_chk_low_hyd_fluid_indicator, 	 gt_Checkpoints_DataPoolValues.t_MiscControlsValues.u8_chk_low_hyd_fluid_indicator)
CNTRL2DP(brakesEngaged, gt_miscCheckpoints.u8_chk_brakes_engaged, 	 gt_Checkpoints_DataPoolValues.t_MiscControlsValues.u8_chk_brakes_engaged)
CNTRL2DP(swMajor, gt_miscCheckpoints.u8_chk_sw_major_revision, 	 gt_Checkpoints_DataPoolValues.t_MiscControlsValues.u8_chk_sw_major_revision)
CNTRL2DP(swMinor, gt_miscCheckpoints.u8_chk_sw_minor_revision, 	 gt_Checkpoints_DataPoolValues.t_MiscControlsValues.u8_chk_sw_minor_revision)