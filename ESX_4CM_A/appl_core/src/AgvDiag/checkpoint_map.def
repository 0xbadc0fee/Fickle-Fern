/* checkpoints_map.def
*
* CNTRL2DP(name, DP_LVALUE, SRC_RVALUE)
*
* DP_LVALUE: expression that can be assigned into (datapool global field)
* SRC_RVALUE: expression that yields the value to assign (from your control structs)
*/

/* Elevator Control checkpoints */
CNTRL2DP(elevatorCP1, 	 gt_elevatorCheckpoints.u8_status,  				gt_Checkpoints_DataPoolValues.t_ElevatorControlValues.u8_status)
CNTRL2DP(elevatorCP2, 	 gt_elevatorCheckpoints.f32_speed_cmd, 				gt_Checkpoints_DataPoolValues.t_ElevatorControlValues.f32_speed_cmd)
CNTRL2DP(elevatorCP3, 	 gt_elevatorCheckpoints.f32_output, 				gt_Checkpoints_DataPoolValues.t_ElevatorControlValues.f32_output)

/* Cleaning Chains Control checkpoints */
CNTRL2DP(cchainsCP2,  	 gt_cleaningShaftCheckpoints.u8_status, 		    gt_Checkpoints_DataPoolValues.t_CleaningChainsControlsValues.u8_status)

/* Front Sweeps Control checkpoints */
CNTRL2DP(fsweepsCP2,  	 gt_frontSweepsCheckpoints.u8_speed_cmd, 	 			gt_Checkpoints_DataPoolValues.t_FrontSweepsControlValues.u8_speed_cmd)

/* Rotary Trap Control checkpoints */
CNTRL2DP(rtrapCP2, 		 gt_rotaryTrapCheckpoints.f32_trap_target_cmd, 	 		gt_Checkpoints_DataPoolValues.t_RotaryTrapValues.f32_trap_target_cmd)

/* Propulsion Control checkpoints */
CNTRL2DP(wheelRPM, 	 	 gt_propCheckpoints.f32_wheel_rpm, 						gt_Checkpoints_DataPoolValues.t_PropulsionControlValues.f32_wheel_rpm)
CNTRL2DP(wheelSpeed, 	 gt_propCheckpoints.f32_wheel_speed_10, 				gt_Checkpoints_DataPoolValues.t_PropulsionControlValues.f32_wheel_speed_mph_x10)
CNTRL2DP(edcEnable,  	 gt_propCheckpoints.u8_edc_enable, 						gt_Checkpoints_DataPoolValues.t_PropulsionControlValues.u8_edc_enable)

/* Suction Fan Control checkpoints */
CNTRL2DP(sFanCP, 		 gt_suctionFanCheckpoints.u8_suctionFanOn, 	 			gt_Checkpoints_DataPoolValues.t_SuctionFanControlValues.u8_suction_fan_on)
CNTRL2DP(sFanPWMCP, 	 gt_suctionFanCheckpoints.u16_pwmStatus, 	 			gt_Checkpoints_DataPoolValues.t_SuctionFanControlValues.u16_pwm_status)

/* Engine Starter Control checkpoints */
CNTRL2DP(engOffCP, 		 gt_engineStarterCheckpoints.u8_eng_status, 	 		gt_Checkpoints_DataPoolValues.t_EngineControlValues.u8_eng_status)
CNTRL2DP(startKeyCP, 	 gt_engineStarterCheckpoints.u8_start_key, 	 			gt_Checkpoints_DataPoolValues.t_EngineControlValues.u8_start_key)
CNTRL2DP(suctionFanCP, 	 gt_engineStarterCheckpoints.u8_suction_fan_status, 	gt_Checkpoints_DataPoolValues.t_EngineControlValues.u8_start_suction_fan_off)
CNTRL2DP(shaftDriveCP,   gt_engineStarterCheckpoints.u8_shaft_drive_status, 	gt_Checkpoints_DataPoolValues.t_EngineControlValues.u8_start_shaft_drive_off)
CNTRL2DP(startNeutralCP, gt_engineStarterCheckpoints.u8_js_neutral, 	 	   	gt_Checkpoints_DataPoolValues.t_EngineControlValues.u8_start_neutral)

/* Throttle Control checkpoints */
CNTRL2DP(throttleRMPCP,  gt_throttleCheckpoints.u16_chk1_eng_spd, 	 	 		gt_Checkpoints_DataPoolValues.t_EngineControlValues.u16_chk1_eng_spd)
CNTRL2DP(throttleUpCP,   gt_throttleCheckpoints.u8_chk2_eng_spd_up_osc,   		gt_Checkpoints_DataPoolValues.t_EngineControlValues.u8_chk2_eng_spd_up_osc)
CNTRL2DP(throttleDownCP, gt_throttleCheckpoints.u8_chk3_eng_spd_down_osc, 		gt_Checkpoints_DataPoolValues.t_EngineControlValues.u8_chk3_eng_spd_down_osc)

/* Cooling Fan Control Parameters */
CNTRL2DP(coolLeadNum, 	gt_coolingFanCheckpoints.u8_leadsensornumber, 	 		gt_Checkpoints_DataPoolValues.t_CoolingFanControlValues.u8_lead_sensor_id)
CNTRL2DP(rtrapCP2, 		gt_coolingFanCheckpoints.f32_cooling_demand_pct, 	 	gt_Checkpoints_DataPoolValues.t_CoolingFanControlValues.f32_cooling_demand_pct)
